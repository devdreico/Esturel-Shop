{
  "name": "esturel-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/sitemap.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "products:check": "node scripts/validate-products.mjs",
    "images:check": "node scripts/check-images.mjs",
    "products:sync": "node scripts/sync-products.mjs",
    "launch:check": "npm run products:check && npm run images:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "framer-motion": "^13.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
